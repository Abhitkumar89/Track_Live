# Copy this file to .env and fill in your values:
#   cp .env.example .env

PORT=3000

# Required — local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/liv-tracker

# Optional — leave unset to use the built-in local Redis (redis-memory-server).
# For Redis Cloud / Docker, set your URL (do not commit real passwords):
# REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST:PORT
